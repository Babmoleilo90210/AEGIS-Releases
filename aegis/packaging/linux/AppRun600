#!/bin/sh
set -eu
app_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
unset JAVA_TOOL_OPTIONS _JAVA_OPTIONS JDK_JAVA_OPTIONS
exec "$app_dir/AEGIS-RuntimeLauncher" "$app_dir/runtime/bin/java" -Xmx1024m -XX:+DisableAttachMechanism -XX:-HeapDumpOnOutOfMemoryError -XX:ErrorFile=/dev/null -Dfile.encoding=UTF-8 "-Daegis.home=$app_dir" -cp "$app_dir/app/*" org.securemail.ui.Launcher "$@"
