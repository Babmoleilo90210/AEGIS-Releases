[Unit]
Description=Dedicated Tor instance for AEGIS
After=network.target

[Service]
Type=simple
ExecStart=/usr/bin/tor --defaults-torrc %h/.local/share/aegis-tor/defaults-torrc -f %h/.local/share/aegis-tor/torrc --RunAsDaemon 0 --DataDirectory %h/.local/share/aegis-tor --SocksPort 127.0.0.1:19050 --ControlPort 127.0.0.1:19051 --CookieAuthentication 1 --CookieAuthFile %h/.local/share/aegis-tor/control_auth_cookie --ClientOnly 1 --SafeLogging 1 --Log "warn stderr"
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
LimitCORE=0

[Install]
WantedBy=default.target
