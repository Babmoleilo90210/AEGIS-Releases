#!/usr/bin/env python3
import argparse
from pathlib import Path
import sys
from release_manifest import verify

parser = argparse.ArgumentParser(description='Verify exact manifest bytes using the pinned owner Ed25519 public key')
parser.add_argument('manifest', type=Path)
parser.add_argument('signature', type=Path)
parser.add_argument('--assets', type=Path)
parser.add_argument('--minimum-version', default='1.0.0')
args = parser.parse_args()
try:
    document = verify(args.manifest, args.signature, args.assets, args.minimum_version)
    print('Ed25519 OK; version ' + document['version'] + '; assets ' + ('OK' if args.assets else 'not checked'))
except Exception as error:
    print('Release rejected: ' + str(error), file=sys.stderr)
    sys.exit(1)
